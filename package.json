    "aws-cdk": "^2.1129.0",
    "aws-cdk-lib": "^2.261.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.6.0",
    "eslint": "^8.57.0",
    "fast-check": "^3.19.0",
    "prettier": "^3.3.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.1",
